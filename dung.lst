 46+  9347              ; --------------------------------------
 47+  9347              ; Zamiana 2-cyfrowej liczby dziesietnej
 48+  9347              ; w formacie ASCII na liczbe 8-bit
 49+  9347              ; input: (HL)	output: A
 50+  9347              ; --------------------------------------
 51+  9347              ascii2num:
 52+  9347 7E           		ld	a,(hl)			; pierwszy obrot Y
 53+  9348 E6 0F        		and	0Fh			; minus ascii bits
 54+  934A 87           		add	a,a			; x 2
 55+  934B 4F           		ld	c,a
 56+  934C 87           		add	a,a
 57+  934D 87           		add	a,a
 58+  934E 81           		add	a,c			; x 10
 59+  934F 4F           		ld	c,a			; save dziesiatki
 60+  9350 23           		inc	hl
 61+  9351 7E           		ld	a,(hl)
 62+  9352 E6 0F        		and	0Fh
 63+  9354 81           		add	a,c			; dziesietne + jednoscioci
 64+  9355 23           		inc	hl
 65+  9356 C9           		ret
