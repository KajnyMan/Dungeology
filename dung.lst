 75+  0000 ~            		ld	a,ATR_MSB
 76+  0000 ~            		add	a,h
 77+  0000 ~            		ld	h,a
 78+  0000 ~            		ld	a,_paper_ink
 79+  0000 ~            	IF	NUL _col
 80+  0000 ~            		ld	(hl),a
 81+  0000 ~            		inc	l
 82+  0000 ~            	ELSE
 83+  0000 ~            		REPT	_col
 84+  0000 ~            			ld	(hl),a
