 77+  935C D6 08        		sub	8
 78+  935E              _low_flags:
 79+  935E 47           		ld	b,a						; ile razy przesuwka
 80+  935F 1A           		ld	a,(de)					; hl zajete wyzej
 81+  9360 4F           		ld	c,a
 82+  9361 3E 01        		ld	a,%00000001
 83+  9363              _roll_right:
 84+  9363 0F           		rrca
 85+  9364 10 FD        		djnz	_roll_right
 86+  9366 C9           		ret
